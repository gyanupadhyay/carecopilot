# ---------------------------------------------------------------------------
# CareCopilot environment. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Primary application connection (read/write, owned by the app role).
DATABASE_URL=postgresql+psycopg://carecopilot:carecopilot@localhost:5432/carecopilot

# Separate least-privilege connection used ONLY by Text-to-SQL.
# This role must have SELECT-only grants on the analytics allowlist and be
# subject to row-level security. See docker/initdb/20-roles.sql.
ANALYTICS_DATABASE_URL=postgresql+psycopg://carecopilot_ro:carecopilot_ro@localhost:5432/carecopilot

# "pgvector" uses a native vector column + HNSW index (production path).
# "array"    stores float8[] and ranks with an in-database cosine function.
#            Use this only when the pgvector extension is unavailable.
VECTOR_BACKEND=pgvector

# --- LLM ------------------------------------------------------------------
# One of: ollama | vllm | ollama_cloud | huggingface | anthropic | gemini |
# groq | openai. Everything but "anthropic" goes through
# app/llm/openai_compatible.py, which speaks Chat Completions — so swapping
# between them changes no application logic.
#
# Self-hosted (the default, and what the PRD asks for; no key needed):
#   ollama     LLM_MODEL=qwen3:8b          local dev, CPU or GPU
#   vllm       LLM_MODEL=Qwen/Qwen3-8B     GPU serving; also Qwen/Qwen3-14B
#
# Same Qwen3, hosted (need LLM_API_KEY). Reach for these when CPU inference
# is too slow to sit through — a 55-case evaluation run is about an hour at
# ~50s/case locally. The weights are the same; only the hardware changes,
# and the trace records which provider served each answer so a measurement
# never loses that context.
#   ollama_cloud  LLM_MODEL=qwen3:8b        key from ollama.com/settings/keys
#   huggingface   LLM_MODEL=Qwen/Qwen3-8B   key from hf.co/settings/tokens
#
# For huggingface, LLM_MODEL may carry a ":provider" suffix to pin which
# backend serves it (e.g. Qwen/Qwen3-8B:nebius). Without one the router
# chooses, so two runs can land on different hardware and their latency
# numbers stop being comparable.
#
# Hosted fallbacks, different models (need LLM_API_KEY):
#   anthropic  LLM_MODEL=claude-opus-5
#   gemini     LLM_MODEL=gemini-flash-lite-latest   (aistudio.google.com)
#   groq       LLM_MODEL=openai/gpt-oss-120b        (console.groq.com)
#
# Free tiers on gemini and groq train on your prompts. Use them only with
# synthetic data — which is all CareCopilot's seed corpus contains — and
# note that doing so gives up the "local/self-hosted inference" property
# the project is built to demonstrate.
LLM_PROVIDER=ollama
LLM_API_KEY=
LLM_MODEL=qwen3:8b
# The tag `ollama pull` fetches in compose. Separate from LLM_MODEL, which
# holds whatever the selected provider calls — switch to Groq and LLM_MODEL
# becomes a Groq id that Ollama's registry has never heard of.
#
# This tag is also the quantization choice (PRD §36 P3): `qwen3:8b` is
# Q4_K_M at ~5.2GB, `qwen3:8b-q8_0` ~8.9GB, `qwen3:8b-fp16` ~16GB. See
# ollama/Modelfile for what to measure before trading up.
OLLAMA_MODEL=qwen3:8b
# Only needed for an OpenAI-compatible endpoint not listed in ENDPOINTS.
# Prefer OLLAMA_BASE_URL / VLLM_BASE_URL below for the local servers: this
# one applies to whichever provider is selected, so a value left here will
# redirect the next provider you switch to.
LLM_BASE_URL=

# Where the self-hosted model servers listen. Compose overrides the Ollama
# one with its service name. vLLM sits on 8001 because the backend owns 8000.
#   vllm serve Qwen/Qwen3-8B --port 8001
OLLAMA_BASE_URL=http://localhost:11434/v1
VLLM_BASE_URL=http://localhost:8001/v1
# Optional cheaper model for routing/reranking. Defaults to LLM_MODEL.
LLM_ROUTER_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- Embeddings -----------------------------------------------------------
# "local"  -> ONNX model via fastembed, no API calls, no key required.
# "voyage" -> Voyage AI hosted embeddings (set EMBEDDING_API_KEY).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_API_KEY=

# --- Retrieval ------------------------------------------------------------
RETRIEVAL_VECTOR_CANDIDATES=20
RETRIEVAL_KEYWORD_CANDIDATES=20
RETRIEVAL_TOP_K=5
RERANKER=llm
RAG_CONTEXT_TOKEN_BUDGET=3000

# --- Auth -----------------------------------------------------------------
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=120
# Validated on every request. A token correctly signed but minted for a
# different issuer or audience is rejected (PRD §5.1).
JWT_ISSUER=carecopilot-demo
JWT_AUDIENCE=carecopilot-api
# Separate secret for signing action-confirmation tokens.
ACTION_TOKEN_SECRET=
ACTION_TOKEN_TTL_SECONDS=300

# --- Knowledge graph ------------------------------------------------------
# Neo4j holds a DERIVED projection of PostgreSQL (PRD §17, §33) — never
# business truth of its own. Rebuild it any time with:
#     python scripts/build_kg.py --reset
#
# Set KG_ENABLED=false to run without it: the KG route then reports the
# relationship data as unavailable instead of the app failing to start.
KG_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=carecopilot
NEO4J_DATABASE=neo4j
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
# Ceilings on one traversal, so a dense subgraph cannot flood the context.
NEO4J_TIMEOUT_SECONDS=5
KG_MAX_ROWS=100

# --- Text-to-SQL limits ---------------------------------------------------
SQL_STATEMENT_TIMEOUT_MS=3000
SQL_MAX_ROWS=200
SQL_MAX_JOINS=4

# --- Frontend / Docker Compose --------------------------------------------
# The API URL the *browser* calls. Baked into the client bundle at build
# time (Next inlines NEXT_PUBLIC_*), so changing it needs a rebuild — and it
# must be a host the browser can resolve, never the compose service name.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Which optional compose services start. Read by the compose CLI itself,
# not by the application.
#
# `local-llm` is the `ollama` + `ollama-pull` pair — the self-hosted model
# server PRD §3 asks for, and the reason `docker compose up` needs no API
# key. It costs a ~5GB pull on first start.
#
# Clear this (COMPOSE_PROFILES=) whenever LLM_PROVIDER names a hosted
# endpoint — ollama_cloud, huggingface, groq, gemini, anthropic, openai.
# The weights would never be called, and the backend starts without waiting
# on a download it does not need.
COMPOSE_PROFILES=local-llm

# Which host interface published ports bind to.
#
# 127.0.0.1 by default, and that default matters most on a machine with a
# public IP. Docker publishes to 0.0.0.0 unless told otherwise, and it does
# so by writing iptables rules that bypass most host firewalls — so a
# published database port on a cloud VM is reachable from the internet even
# when ufw says the port is closed. The stack's own services never use these
# ports anyway; they reach each other by service name over the compose
# network. Publishing exists so a developer can run psql or open the Neo4j
# browser, which loopback serves perfectly.
#
# Set it to 0.0.0.0 only to expose the stack on a trusted LAN, and never on
# a host with a public address. The deployed stack puts Caddy in front
# instead — see docker-compose.prod.yml.
BIND_ADDRESS=127.0.0.1

# The public hostname of a deployment. Only read by docker-compose.prod.yml;
# it must already resolve to the machine, because Caddy proves control of it
# to Let's Encrypt before it can serve HTTPS.
CARECOPILOT_DOMAIN=

# Published ports. Change these if something already owns them locally.
FRONTEND_PORT=3000
BACKEND_PORT=8000
MCP_PORT=8100
OLLAMA_PORT=11434

# 5433, not 5432 — and the reason is worth reading before "fixing" it.
#
# A developer machine with PostgreSQL installed already has something on
# 5432. Docker Desktop does not reliably refuse the publish when that
# happens; it binds, reports success, and connections from the host reach
# the *native* server instead. Nothing errors.
#
# The result is two databases that look like one. The container stack talks
# to its own db over the compose network while everything run from a shell —
# tests, scripts/build_kg.py, the evaluation set — talks to the native
# server through DATABASE_URL. They drift, and the symptom is arbitrary: a
# knowledge graph built from one database and queried by a backend using the
# other, answering questions about records that are not there.
#
# Publishing on 5433 makes the two addressable separately, which is the
# only way to tell them apart.
POSTGRES_PORT=5433

# Compose creates the database with these; the analytics role's password is
# set by docker/initdb/20-roles.sql and must match ANALYTICS_PASSWORD.
POSTGRES_USER=carecopilot
POSTGRES_PASSWORD=carecopilot
POSTGRES_DB=carecopilot
ANALYTICS_PASSWORD=carecopilot_ro

# --- Service wiring -------------------------------------------------------
MCP_SERVER_URL=http://localhost:8100/mcp
MCP_SERVICE_TOKEN=
BACKEND_INTERNAL_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# --- Demo rate limiting ---------------------------------------------------
# Guards /api/chat, /api/chat/stream and /api/analytics — the three
# endpoints that spend a model call. /api/health is never limited, so a
# health check cannot be throttled into causing the outage it prevents.
#
# The per-client limits stop one person hammering the demo. The daily
# budget is the one that protects the API key: a per-client limit does
# nothing against many clients, and a drained free quota takes the demo
# down for everyone until the provider's window rolls over.
#
# Set any of the three to 0 to disable that limit alone.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=6
RATE_LIMIT_PER_DAY=100
RATE_LIMIT_DAILY_BUDGET=1000

# Whether X-Forwarded-For may be believed when identifying a client.
#
# Leave this false locally. The header is client-supplied: with no proxy in
# front, anyone can send a new value on every request and the per-client
# limits above stop existing. Set it to true ONLY when the app sits behind
# a reverse proxy that sets it — docker-compose.prod.yml does, because
# Caddy is in front there — where
# without it every visitor shares the proxy's address and one person's
# traffic rate-limits everybody.
TRUST_PROXY_HEADERS=false

# --- Ops ------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
